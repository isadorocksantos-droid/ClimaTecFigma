<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#98D8FF"
    tools:context=".MainActivity">

    <!-- Área principal -->
    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:background="#98D8FF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título -->
        <TextView
            android:id="@+id/tvWeatherTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weather&#10;App"
            android:textAlignment="center"
            android:gravity="center"
            android:textColor="#6155F5"
            android:textSize="38sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="4"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp" />

        <!-- Data -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09 16 2026"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="4"
            android:layout_marginTop="8dp" />

        <!-- Hora -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8:24 am"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="4"
            android:layout_marginBottom="28dp" />

        <!-- Latitude -->
        <EditText
            android:id="@+id/etLatitude"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Latitude"
            android:textColor="#F2F2F7"
            android:textColorHint="#F2F2F7"
            android:textSize="17sp"
            android:singleLine="true"
            android:inputType="numberDecimal|numberSigned"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#E6E6E6"
            android:layout_marginBottom="10dp" />

        <!-- Longitude -->
        <EditText
            android:id="@+id/etLongitude"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Longitude"
            android:textColor="#F2F2F7"
            android:textColorHint="#F2F2F7"
            android:textSize="17sp"
            android:singleLine="true"
            android:inputType="numberDecimal|numberSigned"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#E6E6E6"
            android:layout_marginBottom="18dp" />

        <!-- Botão pesquisar -->
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="91dp"
            android:text="🔍"
            android:textColor="#F5F5F5"
            android:textSize="18sp"
            android:backgroundTint="#3E7E9B"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:layout_marginBottom="12dp" />

        <!-- Usar localização -->
        <Button
            android:id="@+id/btnLocation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📍  Usar minha localização"
            android:textColor="#F3F3F3"
            android:textSize="16sp"
            android:backgroundTint="#032B67"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
